# ===== Airport physical resources =====
# Runways: comma-separated "ID:length_meters" pairs. Length is used to match
# flights that declare a min_runway_length requirement.
ATC_RUNWAYS=R1:3000,R2:4000,R3:2500

# Gates: either an integer (auto-named G1..Gn) or "G1,G2,G3" comma list.
ATC_GATES=4

# Ground crew is a pool of N concurrent units. Each runway operation consumes 1
# unit for the duration of the runway slot.
ATC_GROUND_CREW=8

# ===== Separation buffers (seconds) =====
# Minimum gap between two consecutive operations on the same runway.
# The buffer used depends on the operation type pair.
ATC_RUNWAY_BUFFER_TAKEOFF_SEC=120
ATC_RUNWAY_BUFFER_LANDING_SEC=90
ATC_RUNWAY_BUFFER_MIXED_SEC=180

# ===== Operation durations (seconds) =====
ATC_ARRIVAL_DURATION_SEC=300
ATC_DEPARTURE_DURATION_SEC=300

# Gate turnaround occupies a gate either after an arrival or before a departure.
ATC_GATE_TURNAROUND_SEC=2400

# ===== Dependency handling =====
# Minimum time between a dependency's completion and the dependent flight's start.
ATC_DEPENDENCY_BUFFER_SEC=600

# ===== Scheduling horizon =====
# Flights that cannot be placed within this window become unscheduled.
ATC_MAX_HORIZON_SEC=86400

# ===== Schedule epoch =====
# All scheduled times are expressed as seconds relative to this ISO-8601 instant.
# Omit to default to UTC midnight of the current day.
# ATC_EPOCH_ISO=2026-01-01T00:00:00Z
